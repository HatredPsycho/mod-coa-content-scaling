#
# CoA Universal Content Scaling Configuration
#

[worldserver]

#
# CoAContentScaling.Enable
#     Description: Enable or disable the entire universal content scaling system.
#     Default:     1 - Enabled
#                  0 - Disabled
#
# This fork ships it off, and its default in the code is off too, so a worldserver that arrives
# without this file does not start scaling because the file is missing. The module is built and
# loaded either way - a realm that compiles it is not yet a realm that plays differently - and is
# switched on in its own step, after a backup, with only Classic in the layout.
CoAContentScaling.Enable = 0

#
# CoAContentScaling.Progression.Mode
#     Description: Progression layout boundary mode.
#     Values:      Auto    - Calculates boundaries based on the enabled expansions and MaxPlayerLevel
#                  Custom  - Uses Progression.ClassicEnd and Progression.TbcEnd
#                  Journey - Lays each expansion over its own, overlapping range (CoAContentScaling.Journey.*),
#                            with the heroics and raids of Outland and Northrend at the endgame level
#     Default:     Auto
#
CoAContentScaling.Progression.Mode = Auto

#
# CoAContentScaling.Progression.ClassicEnd
#     Description: Upper level boundary for Classic content when Progression.Mode = Custom.
#                  0 = Auto (45 on cap 60, 60 on cap 80).
#     Default:     0
#
CoAContentScaling.Progression.ClassicEnd = 0

#
# CoAContentScaling.Progression.TbcEnd
#     Description: Upper level boundary for TBC content when Progression.Mode = Custom.
#                  0 = Auto (55 on cap 60, 70 on cap 80).
#     Default:     0
#
CoAContentScaling.Progression.TbcEnd = 0

#
# CoAContentScaling.TBC.Enable
#     Description: Place The Burning Crusade content in the progression layout. Which maps belong
#                  to it comes from the expansion Map.dbc names for them.
#                  When enabled, TBC content occupies its layout level band, and the
#                  progression layout is rebuilt: at MaxPlayerLevel 60 with
#                  CoAContentScaling.Progression.Mode = Auto, Classic is compressed to 1-45
#                  and TBC takes 45-60, which moves every authored Classic level on the realm.
#                  Set CoAContentScaling.Progression.ClassicEnd = 60 to leave Classic alone and
#                  place TBC content at level 60 instead.
#                  When disabled, TBC content is locked/inaccessible to normal players.
#     Default:     0 - Disabled
#                  1 - Enabled
#
CoAContentScaling.TBC.Enable = 0

#
# CoAContentScaling.WotLK.Enable
#     Description: Place Wrath of the Lich King content in the progression layout.
#                  When enabled, WotLK content occupies its layout level band, and the
#                  progression layout is rebuilt: at MaxPlayerLevel 60 with
#                  CoAContentScaling.Progression.Mode = Auto and CoAContentScaling.TBC.Enable = 1,
#                  the three eras divide the realm as Classic 1-45, TBC 45-55, WotLK 55-60.
#                  Set CoAContentScaling.Progression.ClassicEnd and .TbcEnd with
#                  Progression.Mode = Custom to place the boundaries yourself.
#                  When disabled, WotLK content is locked/inaccessible to normal players.
#     Default:     0 - Disabled
#                  1 - Enabled
#
CoAContentScaling.WotLK.Enable = 0

#
# CoAContentScaling.Journey.Classic.Range
# CoAContentScaling.Journey.Outland.Range
# CoAContentScaling.Journey.Northrend.Range
#     Description: With Progression.Mode = Journey, the levels at which the zones of a part open, from its
#                  first zone to its last, as "from-to". The zones keep their order; the creatures, quests
#                  and items of a part spread over its range the way they spread over the original one.
#                  The old world was 1-55, Outland 58-67, Northrend 68-77. Ranges may overlap.
#     Default:     1-35, 30-43, 40-55
#
CoAContentScaling.Journey.Classic.Range = 1-35
CoAContentScaling.Journey.Outland.Range = 30-43
CoAContentScaling.Journey.Northrend.Range = 40-55

#
# CoAContentScaling.Journey.Endgame.Level
#     Description: The level of the raids and heroic dungeons of Outland and Northrend (50-60).
#     Default:     60
#
CoAContentScaling.Journey.Endgame.Level = 60

#
# CoAContentScaling.Journey.Endgame.BossLevels
#     Description: How many levels above the endgame level their bosses stand (0-3).
#     Default:     3
#
CoAContentScaling.Journey.Endgame.BossLevels = 3

#
# CoAContentScaling.Journey.Endgame.Outland.ItemLevels
# CoAContentScaling.Journey.Endgame.Northrend.ItemLevels
#     Description: The item levels of the rewards of the raids, heroics and arenas of Outland and of
#                  Northrend at the end of the journey, as "lowest-highest". The raids of the old world stay
#                  as they are (66 to 92), so the endgame is a ladder.
#     Default:     75-110, 95-140
#
CoAContentScaling.Journey.Endgame.Outland.ItemLevels = 75-110
CoAContentScaling.Journey.Endgame.Northrend.ItemLevels = 95-140

#
# CoAContentScaling.Journey.Zone.<zone id>
# CoAContentScaling.Journey.Instance.<map id>
#     Description: The entry level of a single zone or instance, set by hand. Zone entries are kept below
#                  the endgame level - 5.
#     Example:     CoAContentScaling.Journey.Zone.3483 = 32    (Hellfire Peninsula from 32)
#                  CoAContentScaling.Journey.Instance.543 = 31 (Hellfire Ramparts from 31)
#     Default:     none

#
# CoAContentScaling.Journey.Creatures.BaseStats
#     Description: The base statistics of the creatures of the old world, Outland and Northrend that the
#                  journey moves: "journey" builds them from the old world's table, which rises to 60
#                  without the jumps of the later tables; "original" keeps their expansion's. The heroics
#                  and raids keep theirs either way.
#     Default:     journey
#
CoAContentScaling.Journey.Creatures.BaseStats = journey

#
# CoAContentScaling.Journey.Window.Enable
# CoAContentScaling.Journey.Window.Below
# CoAContentScaling.Journey.Window.Above
#     Description: Where an open-world creature lifted to a character stands for that character: by its
#                  place in its zone, from Below levels under the character (the zone's lowest creatures)
#                  to Above levels over it (its highest), one more for an elite or a rare. Without the
#                  window every lifted creature stands at the character's level minus
#                  DestinyWeaver.Scaling.Offset. Below and Above are 0-10.
#     Default:     1, 2, 2
#
CoAContentScaling.Journey.Window.Enable = 1
CoAContentScaling.Journey.Window.Below = 2
CoAContentScaling.Journey.Window.Above = 2

#
# CoAContentScaling.Journey.Trainers.Enable
#     Description: Riding and the professions are taught at the levels of the journey; expert riding
#                  (flying) opens at the doors of Outland. The class trainers keep CoA's own levels.
#     Default:     1
#
CoAContentScaling.Journey.Trainers.Enable = 1

#
# CoAContentScaling.Journey.Battlegrounds.Enable
#     Description: The Eye of the Storm, the Strand of the Ancients and the Isle of Conquest open at the
#                  endgame level, and their first bracket takes a character of it. The random battleground
#                  still draws them only above their authored level.
#     Default:     1
#
CoAContentScaling.Journey.Battlegrounds.Enable = 1

#
# CoAContentScaling.Journey.Enchantments.Enable
#     Description: Gems and the enchantments of Outland's and Northrend's professions keep what the top
#                  rewards of their game kept of their statistics; a socket bonus keeps what its item kept.
#                  The level they ask for follows the end of their game's road. On the journey this
#                  replaces CoAContentScaling.ScaleEnchantments.
#     Default:     1
#
CoAContentScaling.Journey.Enchantments.Enable = 1

#
# CoAContentScaling.Journey.Quests.XpRate
# CoAContentScaling.Journey.Quests.XpRate.<Part>
#     Description: The experience of quests on the journey, on top of the core's quest rate. Part:
#                  OldWorld, Outland, Northrend, Endgame - for one part, wins over the general one.
#                  Range 0-10.
#     Default:     1.0
#
CoAContentScaling.Journey.Quests.XpRate = 1.0

#
# CoAContentScaling.AuthenticMaps
#     Description: Comma separated map ids played at their authored levels on every difficulty.
#                  Creatures keep their level, health and damage, entry keeps its authored level
#                  requirements, loot is not reduced for small groups, and items whose every
#                  spawned source is on one of these maps keep their authored stats. Destiny Weaver
#                  does not lift creatures there. Quests are still scaled. Read at startup only.
#     Default:     309, 509, 409, 469, 531, 230, 229, 429, 289, 329
#                  "" - Every map is scaled
#     Raids:       309 - Zul'Gurub
#                  509 - Ruins of Ahn'Qiraj (AQ20)
#                  409 - Molten Core
#                  469 - Blackwing Lair
#                  531 - Temple of Ahn'Qiraj (AQ40)
#     Dungeons:    230 - Blackrock Depths
#                  229 - Blackrock Spire (Lower and Upper)
#                  429 - Dire Maul
#                  289 - Scholomance
#                  329 - Stratholme
#
CoAContentScaling.AuthenticMaps = 309, 509, 409, 469, 531, 230, 229, 429, 289, 329

#
# CoAContentScaling.AuthenticHeroicMaps
#     Description: Comma separated dungeon map ids whose Heroic and Mythic difficulties are played at
#                  their authored levels, like AuthenticMaps, while Normal stays scaled. The Heroic and
#                  Mythic loot variants of items dropped there keep their authored stats. Maps also in
#                  AuthenticMaps are authentic on every difficulty. Read at startup only.
#     Default:     33, 34, 36, 43, 47, 48, 70, 90, 109, 129, 189, 209, 229, 230, 289, 329, 349, 389, 429
#                  "" - Heroic and Mythic follow Normal
#     Dungeons:    33  - Shadowfang Keep
#                  34  - The Stockade
#                  36  - The Deadmines
#                  43  - Wailing Caverns
#                  47  - Razorfen Kraul
#                  48  - Blackfathom Deeps
#                  70  - Uldaman
#                  90  - Gnomeregan
#                  109 - Sunken Temple
#                  129 - Razorfen Downs
#                  189 - Scarlet Monastery
#                  209 - Zul'Farrak
#                  229 - Blackrock Spire (Lower and Upper)
#                  230 - Blackrock Depths
#                  289 - Scholomance
#                  329 - Stratholme
#                  349 - Maraudon
#                  389 - Ragefire Chasm
#                  429 - Dire Maul
#
CoAContentScaling.AuthenticHeroicMaps = 33, 34, 36, 43, 47, 48, 70, 90, 109, 129, 189, 209, 229, 230, 289, 329, 349, 389, 429

#
# CoAContentScaling.AuthenticHeroicMinLevel
#     Description: Level a character needs for the Heroic and Mythic difficulties of the dungeons in
#                  AuthenticHeroicMaps, in the dungeon finder and at the entrance. The database carries
#                  the Normal entry levels for them, which would let a level 10 character into a
#                  Deadmines with level 63 bosses. Never lowers an authored requirement.
#     Default:     60
#                  0  - Authored entry levels
#
CoAContentScaling.AuthenticHeroicMinLevel = 60

#
# CoAContentScaling.GroupScaling.Enable
#     Description: Dynamically scale dungeons and raids based on group size (1..N players).
#     Default:     1 - Enabled
#                  0 - Disabled
#
CoAContentScaling.GroupScaling.Enable = 1

#
# CoAContentScaling.GroupScaling.LockOnEncounterStart
#     Description: Freeze participant count upon pull to prevent join/leave exploits.
#     Default:     1 - Enabled
#                  0 - Disabled
#
CoAContentScaling.GroupScaling.LockOnEncounterStart = 1

#
# CoAContentScaling.GroupScaling.AllowSoloRaids
#     Description: Allow solo players to enter raid instances without being in a raid group.
#     Default:     1 - Enabled
#                  0 - Disabled
#
CoAContentScaling.GroupScaling.AllowSoloRaids = 1

#
# CoAContentScaling.AdaptiveMechanics.Enable
#     Description: Adapt encounter mechanics (target counts, adds) for small groups.
#     Default:     1 - Enabled
#                  0 - Disabled
#
CoAContentScaling.AdaptiveMechanics.Enable = 1

#
# CoAContentScaling.SoloAssist.Mode
#     Description: Assist mode for solo dungeon/raid gameplay.
#     Values:      None  (or 0) - No passive assist aura
#                  Light (or 1) - 15% unavoidable damage mitigation
#                  Full  (or 2) - 30% unavoidable damage mitigation
#     Default:     None
#
CoAContentScaling.SoloAssist.Mode = None

#
# CoAContentScaling.Difficulty.DamageMultiplier
#     Description: Damage dungeon and raid enemies deal to players and their pets, after group
#                  scaling and solo assist. Melee, direct spells and periodic damage; instant kills
#                  and percentage-of-health mechanics keep their size. Requires GroupScaling.Enable.
#                  Reloadable with .reload config.
#     Range:       0.25 to 2.0 - lower is easier
#     Default:     1.0 - unchanged
#
CoAContentScaling.Difficulty.DamageMultiplier = 1.0

#
# CoAContentScaling.World.Leech.Enable
# CoAContentScaling.World.Leech.Percent
#     Description: Players heal themselves for a share of the damage they deal to creatures in the
#                  open world: melee, spells and periodic damage, after mitigation and never more
#                  than the creature had left. Not in instances or battlegrounds, not against players
#                  or their pets. Independent of group scaling. Reloadable with .reload config.
#     Range:       Percent 0 to 100
#     Default:     0 - Disabled, 5.0 percent once enabled
#
CoAContentScaling.World.Leech.Enable = 0
CoAContentScaling.World.Leech.Percent = 5.0

#
# CoAContentScaling.Rewards.ScaleLootCount
#     Description: Scale dropped item count with group size (guaranteeing at least 1 drop).
#     Default:     1 - Enabled
#                  0 - Disabled
#
CoAContentScaling.Rewards.ScaleLootCount = 1

#
# CoAContentScaling.ScaleItems
#     Description: Dynamically scale item budgets, ratings, armor, and weapon DPS to progression boundaries.
#     Default:     1 - Enabled
#                  0 - Disabled
#
CoAContentScaling.ScaleItems = 1

#
# CoAContentScaling.PublishAuraAmounts
#     Description: Send the amount an item-granted aura actually applies to the player's client, so
#                  the CoAScaleTooltips addon can show it instead of the authored figure. The buff
#                  tooltip is drawn from the client's own Spell.dbc and cannot be corrected without
#                  this. Without the addon installed the messages are simply ignored.
#     Default:     1 - Enabled
#                  0 - Disabled
#
CoAContentScaling.PublishAuraAmounts = 1

#
# CoAContentScaling.ScaleEnchantments
#     Description: Cut the flat amounts an enchantment, a gem or a socket bonus adds by the same
#                  factor as the item it sits on. An enchantment belongs to no item of its own, so
#                  the host decides. Off leaves them at their authored values, which makes a
#                  scaled-down character relatively stronger the better its enchants are.
#     Default:     1 - Enabled
#                  0 - Disabled
#
CoAContentScaling.ScaleEnchantments = 1

#
# CoAContentScaling.Debug
#     Description: Enable verbose debug logging for scaling calculations.
#     Default:     0 - Disabled
#                  1 - Enabled
#
CoAContentScaling.Debug = 0
